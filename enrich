<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Enriquecer clientes — Vel Papier</title>
<script>document.documentElement.setAttribute('data-theme', localStorage.getItem('vp_theme') || 'light');</script>
<link rel="stylesheet" href="style.css">
<style>
  .enrich-wrap { max-width: 900px; margin: 0 auto; padding: 1.5rem; }
  .enrich-upload-row { display: flex; flex-direction: column; gap: 12px; margin-bottom: 1rem; }
  .enrich-field { display: flex; flex-direction: column; gap: 6px; }
  .enrich-field label { font-size: 13px; font-weight: 600; color: var(--text-muted); }
  .enrich-field input[type="file"] { font-size: 13px; }
  .enrich-summary { display: flex; gap: 10px; flex-wrap: wrap; margin: 1rem 0; }
  .enrich-summary-pill { padding: 6px 12px; border-radius: var(--radius-md); font-size: 12px; font-weight: 600; border: 0.5px solid var(--border); }
  .enrich-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 1rem; }
  .enrich-table th, .enrich-table td { text-align: left; padding: 6px 8px; border-bottom: 0.5px solid var(--border); vertical-align: top; }
  .enrich-table th { color: var(--text-muted); font-weight: 600; }
  .enrich-status-ready { color: var(--green-text, #1a7f37); font-weight: 600; }
  .enrich-status-nothing_to_fill { color: var(--text-faint); }
  .enrich-status-no_customer_match, .enrich-status-no_csv_match { color: var(--red-text, #c0392b); font-weight: 600; }
  .enrich-proposed-field { display: block; }
  .enrich-actions { display: flex; gap: 10px; margin-top: 1rem; }
</style>
</head>
<body>

<div class="enrich-wrap">
  <h1 style="font-size:20px;font-weight:700;margin-bottom:4px">Enriquecer clientes desde etiquetas antiguas</h1>
  <p style="font-size:13px;color:var(--text-muted);margin-bottom:1.5rem">
    Sube el CSV histórico completo (para relacionar Tracking ID → usuario) y todas las etiquetas PDF que quieras procesar.
    Solo se rellenan campos que estén vacíos — nunca se sobreescribe información existente.
  </p>

  <div class="enrich-upload-row">
    <div class="enrich-field">
      <label for="csv-input">CSV histórico completo</label>
      <input type="file" id="csv-input" accept=".csv">
    </div>
    <div class="enrich-field">
      <label for="pdf-input">Etiquetas PDF (puedes seleccionar varias a la vez)</label>
      <input type="file" id="pdf-input" accept=".pdf" multiple>
    </div>
    <button class="qc-submit" id="preview-btn" style="width:fit-content;padding:8px 20px">Vista previa</button>
  </div>

  <div id="status-msg" style="font-size:13px;color:var(--text-muted)"></div>

  <div id="summary-box" style="display:none">
    <div class="enrich-summary" id="summary-pills"></div>
    <div class="enrich-actions">
      <button class="qc-submit" id="apply-btn" style="width:fit-content;padding:8px 20px">Aplicar cambios (<span id="apply-count">0</span>)</button>
    </div>
    <div id="results-table-container"></div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="common.js"></script>
<script>
  const PREVIEW_URL = 'https://n8n.srv1040167.hstgr.cloud/webhook/enrich-preview';
  const APPLY_URL    = 'https://n8n.srv1040167.hstgr.cloud/webhook/enrich-apply';
  const VP_TOKEN = '0924'; // matches the X-VP-Token check in both N8N workflows

  let lastResults = [];

  document.getElementById('preview-btn').addEventListener('click', async () => {
    const csvFile = document.getElementById('csv-input').files[0];
    const pdfFiles = document.getElementById('pdf-input').files;
    const statusEl = document.getElementById('status-msg');

    if (!csvFile) { statusEl.textContent = 'Selecciona el CSV histórico primero.'; return; }
    if (!pdfFiles.length) { statusEl.textContent = 'Selecciona al menos un PDF.'; return; }

    statusEl.textContent = `Comprimiendo ${pdfFiles.length} PDF(s)...`;
    document.getElementById('summary-box').style.display = 'none';

    const zip = new JSZip();
    for (const f of pdfFiles) {
      zip.file(f.name, f);
    }
    const zipBlob = await zip.generateAsync({ type: 'blob' });

    statusEl.textContent = `Procesando ${pdfFiles.length} PDF(s)... esto puede tardar un momento.`;

    const fd = new FormData();
    fd.append('csv', csvFile);
    fd.append('pdf_zip', zipBlob, 'labels.zip');

    try {
      const resp = await fetch(PREVIEW_URL, {
        method: 'POST',
        headers: { 'X-VP-Token': VP_TOKEN },
        body: fd,
      });
      if (!resp.ok) {
        const txt = await resp.text();
        throw new Error(`Error ${resp.status}: ${txt.slice(0, 300)}`);
      }
      const data = await resp.json();
      statusEl.textContent = '';
      renderResults(data);
    } catch (e) {
      statusEl.textContent = 'Error: ' + e.message;
    }
  });

  function renderResults(data) {
    lastResults = data.results || [];
    const s = data.summary || {};

    document.getElementById('summary-pills').innerHTML = `
      <span class="enrich-summary-pill">Total: ${s.total_labels || 0}</span>
      <span class="enrich-summary-pill enrich-status-ready">Listos para aplicar: ${s.ready || 0}</span>
      <span class="enrich-summary-pill enrich-status-nothing_to_fill">Ya completos: ${s.nothing_to_fill || 0}</span>
      <span class="enrich-summary-pill enrich-status-no_customer_match">Sin cliente coincidente: ${s.no_customer_match || 0}</span>
      <span class="enrich-summary-pill enrich-status-no_csv_match">Sin coincidencia en CSV: ${s.no_csv_match || 0}</span>
    `;
    document.getElementById('apply-count').textContent = s.ready || 0;
    document.getElementById('summary-box').style.display = 'block';

    const rows = lastResults.map(r => {
      const proposedHtml = Object.entries(r.proposed || {})
        .map(([k, v]) => `<span class="enrich-proposed-field"><b>${escHtml(k)}:</b> ${escHtml(v)}</span>`)
        .join('') || '—';
      return `<tr>
        <td>${escHtml(r.tracking_id)}</td>
        <td>${escHtml(r.username || '—')}</td>
        <td>${escHtml(r.customer_id || '—')}</td>
        <td class="enrich-status-${r.status}">${escHtml(statusLabel(r.status))}</td>
        <td>${proposedHtml}</td>
        <td>${escHtml(r.message || '')}</td>
      </tr>`;
    }).join('');

    document.getElementById('results-table-container').innerHTML = `
      <table class="enrich-table">
        <thead><tr>
          <th>Tracking ID</th><th>Usuario</th><th>Cliente</th><th>Estado</th><th>Se rellenará</th><th>Nota</th>
        </tr></thead>
        <tbody>${rows}</tbody>
      </table>
    `;
  }

  function statusLabel(status) {
    return {
      ready: 'Listo',
      nothing_to_fill: 'Ya completo',
      no_customer_match: 'Sin cliente',
      no_csv_match: 'Sin CSV',
    }[status] || status;
  }

  function escHtml(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  document.getElementById('apply-btn').addEventListener('click', async () => {
    const readyItems = lastResults.filter(r => r.status === 'ready');
    if (!readyItems.length) { alert('No hay cambios listos para aplicar.'); return; }
    if (!confirm(`¿Aplicar ${readyItems.length} actualizaciones de clientes? Esto no se puede deshacer automáticamente.`)) return;

    const statusEl = document.getElementById('status-msg');
    statusEl.textContent = 'Aplicando cambios...';

    try {
      const resp = await fetch(APPLY_URL, {
        method: 'POST',
        headers: { 'X-VP-Token': VP_TOKEN, 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: readyItems }),
      });
      if (!resp.ok) {
        const txt = await resp.text();
        throw new Error(`Error ${resp.status}: ${txt.slice(0, 300)}`);
      }
      const data = await resp.json();
      statusEl.textContent = `Listo: ${data.applied_count} cliente(s) actualizados.` +
        (data.errors && data.errors.length ? ` ${data.errors.length} error(es) — revisa la consola.` : '');
      if (data.errors && data.errors.length) console.log('Enrich apply errors:', data.errors);
    } catch (e) {
      statusEl.textContent = 'Error: ' + e.message;
    }
  });
</script>
</body>
</html>
